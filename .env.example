# Drama Platform Environment Configuration

# Public Domain & Metadata
NEXT_PUBLIC_SITE_DOMAIN=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Drama Platform"

# Supabase Project Configuration (Target ref: zvwltfqhbpqtnjbsflvk)
NEXT_PUBLIC_SUPABASE_URL=https://zvwltfqhbpqtnjbsflvk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_project_publishable_key
# Compatibility alternative only when the code explicitly supports it:
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_user_supplied_legacy_anon_key
# Only needed for explicitly privileged server/import operations (Never expose to client):
SUPABASE_SECRET_KEY=replace_with_server_only_secret_if_required

# Pilot Configuration
# Preferred pilot: First subtitled season of Mehmed: Fetihler Sultani confirmed in catalog (collection-68)
NEXT_PUBLIC_PILOT_DRAMA_ID=mehmed-fetihler-sultani
NEXT_PUBLIC_PILOT_COLLECTION_ID=collection-68

# Feature Flags & Modes
CATALOG_RELEASE_MODE=staging
ENABLE_VIEWER_ACCOUNTS=false

# Playback Problem Diagnostic Destination
NEXT_PUBLIC_REPORT_DESTINATION_TYPE=clipboard
NEXT_PUBLIC_REPORT_EMAIL=diagnostics@example.com

# Admin Security (Supabase Auth + admin_memberships role check)
ADMIN_MODE=development
ADMIN_SECRET_KEY=change_this_to_a_secure_token_for_production
